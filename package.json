{
  "name": "komorebi",
  "version": "0.23.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "botany:board": "node scripts/build_botanical_reference_board.mjs quercus-robur",
    "botany:validate": "node scripts/validate_botanical_library.mjs",
    "preview": "vite preview",
    "review": "node scripts/review.mjs && node scripts/auto_push.mjs review-garden",
    "review:quick": "node scripts/review.mjs --quick && node scripts/auto_push.mjs review-quick",
    "review:full": "node scripts/review.mjs --full && node scripts/auto_push.mjs review-full",
    "review:gardener": "node scripts/review_character_v052.mjs && node scripts/auto_push.mjs gardener-v052",
    "review:clean": "node scripts/clean_reviews.mjs",
    "review:generative-oak": "node scripts/review_generative_oak.mjs",
    "review:kaykit-legacy": "node scripts/review_kaykit_v045.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  }
}
